// WAYBAR GENERAL //

{
        "layer": "top",
        "position": "bottom",
        "exclusive-zone": 0,
        "margin-top": 0,
        "margin-bottom": 5,
        "margin-left": 5,
        "margin-right": 5,
        "max-height": 20,
        "spacing": 8,
        "exclusive": false,

// LEFT MODULES //

        "modules-left": ["custom/oslogo", "hyprland/workspaces"],
        
        "custom/oslogo": {
                "format": " 󰣇 ",
                "tooltip": false,
                "on-click": "rofi -show drun"
        },

        "hyprland/workspaces": {
                "persistent-workspaces": {
                        "*": 4
                }, 
                "on-click": "activate",
                "height": 20
        },

// CENTER MODULES //

// RIGHT MODULES //

        "modules-right": ["pulseaudio", "network", "clock"],

        "group/audio": {
                "orientation": "horizontal",
                "modules": ["pulseaudio/slider", "pulseaudio"]
        },

        "pulseaudio/slider": {
                "min": 0,
                "max": 100,
                "orientation": "horizontal"
        },

        "pulseaudio": {
                "format": "{icon}{volume}% ",
                "format-icons": [" 󰕿 ", " 󰖀 ", " 󰕾 "],
                "format-muted": " 󰖁  0% "
        },

        "network": {
                "interval": 60,
                "format-ethernet": "  ",
                "format-disconnected": " 󰈀 ",
                "format-disabled": "  "
        },

        "clock": {
                "interval": 60,
                "format": " {:%H:%M} ",
                "max-length": 25,
                "tooltip": false
        }
}
